rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth.uid == userId &&
                      request.resource.size < 5 * 1024 * 1024 && // 5MB limit
                      request.resource.contentType.matches('image/.*');
    }

    match /chat_media/{serverId}/{channelId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                     request.resource.size < 8 * 1024 * 1024 && // 8MB limit
                     request.resource.contentType.matches('image/.*');
    }

    // Generic rule for other uploads
    match /{path=**} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && path[0] != 'avatars';
    }
  }
}