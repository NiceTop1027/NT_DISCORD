{
  "rules": {
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth.uid == $uid"
      }
    },
    "voiceChannels": {
      "$channelId": {
        ".read": "auth != null",
        "participants": {
          "$uid": {
            ".write": "auth.uid == $uid"
          }
        }
      }
    },
    "signaling": {
      "$channelId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}