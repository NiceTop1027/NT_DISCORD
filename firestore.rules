rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // TEMPORARY: Allow all authenticated reads and writes for debugging
    match /{document=**} {
      allow read, write: if isSignedIn();
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isServerMember(serverId) {
      let userData = getUserData(request.auth.uid);
      return isSignedIn() &&
             'servers' in userData &&
             userData.servers is list &&
             serverId in userData.servers;
    }

    function isServerOwner(serverId) {
      return isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId;
    }

    match /users/{userId} {
      allow write: if isUser(userId);
    }

    match /servers/{serverId} {
      allow update, delete: if isServerOwner(serverId);
      // Disallow client-side creation
      allow create: if false;

      match /channels/{channelId} {
        allow update, delete: if isServerOwner(serverId);
        // Disallow client-side creation
        allow create: if false;

        match /messages/{messageId} {
          allow create: if isServerMember(serverId) && request.resource.data.senderId == request.auth.uid;
          allow update: if request.auth.uid == resource.data.senderId;
          allow delete: if request.auth.uid == resource.data.senderId || isServerOwner(serverId);
        }
      }

      match /roles/{roleId} {
        allow write: if isServerOwner(serverId);
      }
    }

    match /invites/{inviteId} {
      allow create: if isServerMember(request.resource.data.serverId) && request.resource.data.creatorId == request.auth.uid;
    }
  }
}
